# Banco de dados PostgreSQL (RNF-04 / RNF-05)
DATABASE_URL=postgresql://usuario:senha_segura@db:5432/assinatura_pdf

# Caminhos das chaves assimétricas RSA-2048 para assinatura do JWT RS256 (REQ-17)
JWT_PRIVATE_KEY_PATH=private.pem
JWT_PUBLIC_KEY_PATH=public.pem
JWT_ISSUER=assinatura-pdf-api

# Chave mestra para criptografia das chaves privadas dos usuários em repouso (REQ-45)
MASTER_KEY=gere_uma_chave_fernet_32_bytes_base64_aqui

# Chave de criptografia dos segredos TOTP no banco de dados (REQ-12)
TOTP_ENCRYPTION_KEY=gere_outra_chave_fernet_32_bytes_base64_aqui

# Lista explícita de origens permitidas no CORS — nunca usar * (REQ-31)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Relying Party para Passkeys WebAuthn / FIDO2 (REQ-09)
RP_ID=localhost
RP_NAME=SignPDF Secure

# Parâmetros de sessão, bloqueio e rate limiting (REQ-03, REQ-05, REQ-18, REQ-19, REQ-53)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_VERIFY_PER_MIN=20
